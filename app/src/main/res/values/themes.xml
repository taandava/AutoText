<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Helper" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#0D1117</item>
        <item name="android:navigationBarColor">#0D1117</item>
        <item name="android:windowBackground">#0D1117</item>
    </style>
    <style name="Theme.Helper.FullScreen" parent="Theme.Helper">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
    <style name="Theme.Helper.Transparent" parent="android:Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
