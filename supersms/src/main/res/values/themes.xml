<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Super" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#F6F7FA</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Super.FullScreen" parent="Theme.Super">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
    <style name="Theme.Super.Transparent" parent="android:Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
